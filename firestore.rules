rules_version = '2';
// Vorlage – die echte Version in der Firebase-Konsole enthält statt GRUPPENCODE den geheimen Code aus dem Einladungslink.
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{code} {
      allow get, create: if request.auth != null && code == 'GRUPPENCODE';
      allow list, update, delete: if false;

      match /{collection}/{id} {
        allow read, write: if request.auth != null
          && code == 'GRUPPENCODE'
          && collection in ['games', 'players', 'plays', 'covers', 'rankings'];
      }
    }
  }
}
