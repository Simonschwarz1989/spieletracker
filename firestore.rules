rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Gruppen kann man nur mit bekanntem Code öffnen – eine Liste aller Gruppen gibt es nicht.
    match /groups/{code} {
      allow get, create: if request.auth != null;
      allow list, update, delete: if false;

      match /{collection}/{id} {
        allow read, write: if request.auth != null
          && collection in ['games', 'players', 'plays', 'covers']
          && exists(/databases/$(database)/documents/groups/$(code));
      }
    }
  }
}
